\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Norm of gradient, using gradient method with backtracking, $x_0 = 0$, $\alpha = 0.25$, $\rho = 0.5$, $c = 0.5$}}{11}{figure.12}\protected@file@percent }
