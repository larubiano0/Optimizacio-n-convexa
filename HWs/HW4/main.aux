\@writefile{toc}{\contentsline {section}{\numberline {1}Given $x \in C$ with $C$ a convex set, let $N_C(x) := \{ g : \langle g, y - x \rangle \leq 0, \forall y \in C \}$. }{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{2}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}\textit  {Convex hull or envelope of a function. } The convex hull or envelope of a function $f: \mathbb  {R}^n \rightarrow \mathbb  {R}$ is defined as $$g(x) = \inf \{ t \ | \ (x,t) \in \textbf  {conv epi } f \}$$ Geometrically, the epigraph of $g$ is the convex hull of the epigraph of $f$. Show that $g$ is the largest convex underestimator of $f$. In other words, show that if $h$ is convex and satisfies $h(x) \leq f(x)$ for all $x$, then $h(x)\leq g(x)$ for all $x$. Ex. 3.30. Convex Optimization, Boyd.}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{3}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Consider the function $f(x)=\langle c, x \rangle - \DOTSB \tsum \slimits@ _{j=1}^m \log (1- \langle a_j, x \rangle ) - \DOTSB \tsum \slimits@ _{i=1}^n \log (1 - x_i^2)$. Take $n=5000$ and $m=2000$ and vectors $c$ and $a_j$ chocen arbitrarily such that $\| a_j \| = 1$. For all methods start the iterations at $x_0 = 0$ and stopping criterion $\| \nabla f(x_k) \| \leq \varepsilon $. Graph $\log (f(x_k) - f^*)$ in each iteration (estimate $f^*$ as best as possible) and compare the execution time of the methods.}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{3}{section*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $\log (f(x) - f^*)$, using quasi-Newton BFGS method, $x_0 = 0$}}{5}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Condition number of $H_k$, using quasi-Newton BFGS method, $x_0 = 0$}}{5}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{5}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces $\log (f(x) - f^*)$, using confidence region Newton method, $x_0 = 0$}}{7}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $\Delta _k$, using confidence region Newton method, $x_0 = 0$}}{7}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{7}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces $\log (f(x) - f^*)$, using accelerated Nesterov method, $x_0 = 0$}}{8}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{8}{section*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Polyak vs Iterations}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:3}{{6}{9}{Polyak vs Iterations}{figure.6}{}}
