\@writefile{toc}{\contentsline {section}{\numberline {4}Let $f: \mathbb  {R} \rightarrow \mathbb  {R}$. Show that $f$ is non decreasing if and only if there is a convex differentiable function $\varphi $ such that $f(x) = \varphi '(x)$.}{2}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{2}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Let $f: C \rightarrow \mathbb  {R}$ a twice Fréchet differentiable function on a convex set $C \subseteq \mathbb  {R}^n$. The following statements are known to be equivalent: Ex. 4.11. Foundations of Optimization, Güler.}{3}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{3}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Consider the function $f(x) = \langle c, x \rangle - \displaystyle \DOTSB \tsum \slimits@ _{j=1}^m \log (1 - \langle a_j, x \rangle ) - \displaystyle \DOTSB \tsum \slimits@ _{i=1}^n \log (1- x_i^2)$. Show that $f$ is convex.}{5}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{5}{section*.11}\protected@file@percent }
