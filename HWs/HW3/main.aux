\@writefile{toc}{\contentsline {section}{\numberline {1}Let $K_1$ and $K_2$ be convex cones in a vector space $E$. Show that $K_1 + K_2$ is a convex cone, $K_1 + K_2 \subseteq \text  {co}(K_1 \cup K_2)$, if both cones contain the origin, then $K_1 + K_2 = \text  {co}(K_1 \cup K_2)$. Ex. 4.3. Foundations of Optimization, Güler.}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Which of the following sets are convex? Ex. 2.12. Convex Optimization, Boyd.}{1}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Solution:}{1}{section*.3}\protected@file@percent }
