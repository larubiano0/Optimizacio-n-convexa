\@writefile{toc}{\contentsline {part}{I\hspace  {1em}}{1}{part.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {1}Ex. 11.13. Foundations of Optimization, Güler. \textbf  {(von Neumann)} In this problem, the famous \textit  {von Neumann minimax theorem} for bimatrix games will be proved using linear programming duality. This result, which von Neumann proved in 1928 by advanced methods (Brouwer’s fixed point theorem), was the starting point of game theory.\\ Let $A$ be an $m \times n$ matrix and denote by $\Delta _{m-1}$ and $\Delta _{n-1}$ the unit simplices, where $$\Delta _{n-1} = \{x \in \mathbb  {R}^n: x \geq 0, \DOTSB \tsum \slimits@ _{i=1}^{n} x_i = 1\},$$ and where $\Delta _{m-1}$ is defined similarly. The von Neumann minimax theorem states that $$\min _{x \in \Delta _{n-1}} \max _{y \in \Delta _{m-1}} \langle Ax, y \rangle = \max _{y \in \Delta _{m-1}} \min _{x \in \Delta _{n-1}} \langle Ax, y \rangle .$$ Denote by $a^i$ and $a_j$ the $i$-th row and $j$-th column of $A$, respectively.}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{2}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{2}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{3}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Ex. 11.15. Foundations of Optimization, Güler. (Teboulle) Consider the minimization problem $$\min -\DOTSB \tsum \slimits@ _{i=1}^{n} \ln x_i$$ $$\text  {s.t.} \frac  {1}{2} \langle Qx, x \rangle + \langle b, x \rangle + c \leq 0,$$ where $Q$ is an $n \times n$ symmetric positive definite matrix. Assume that the constraint set contains a vector $\bar  {x}>0$ such that $\frac  {1}{2} \langle Q\bar  {x}, \bar  {x} \rangle + \langle b, \bar  {x} \rangle + c<0$. }{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Proof:}{3}{section*.5}\protected@file@percent }
